DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=ravi.example.com,127.0.0.1
DJANGO_DB_PATH=/var/lib/ravi-api/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/ravi-api/media
DJANGO_STATIC_ROOT=/var/lib/ravi-api/staticfiles
DJANGO_SECURE_PROXY_SSL_HEADER=true
HF_HOME=/var/lib/ravi-api/huggingface
