[Unit]
Description=Clean up expired Ravi caption data
After=network.target

[Service]
Type=oneshot
User=ravi
Group=ravi
WorkingDirectory=/opt/ravi-api
EnvironmentFile=/etc/ravi-api.env
StateDirectory=ravi-api
ExecStart=/opt/ravi-api/.venv/bin/python manage.py cleanup_caption_data
PrivateTmp=true
NoNewPrivileges=true
