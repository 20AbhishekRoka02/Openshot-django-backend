[Unit]
Description=Ravi Caption API
After=network.target

[Service]
Type=simple
User=ravi
Group=ravi
WorkingDirectory=/opt/ravi-api
EnvironmentFile=/etc/ravi-api.env
StateDirectory=ravi-api
ExecStart=/opt/ravi-api/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 3600 --bind 127.0.0.1:8000 videoback.wsgi:application
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
